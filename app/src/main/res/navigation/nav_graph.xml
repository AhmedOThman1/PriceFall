<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/launcherFragment">

    <fragment
        android:id="@+id/launcherFragment"
        android:name="com.pricefall.ui.fragments.LauncherFragment"
        android:label="fragment_launcher"
        tools:layout="@layout/fragment_launcher" >
        <action
            android:id="@+id/action_launcherFragment_to_authFragment"
            app:destination="@id/authFragment"
            app:popUpTo="@id/launcherFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_launcherFragment_to_buyerMainFragment"
            app:destination="@id/buyerMainFragment"
            app:popUpTo="@id/launcherFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_launcherFragment_to_sellerMainFragment"
            app:destination="@id/sellerMainFragment"
            app:popUpTo="@id/launcherFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/authFragment"
        android:name="com.pricefall.ui.fragments.auth.AuthFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_authFragment_to_buyerMainFragment"
            app:destination="@id/buyerMainFragment"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_authFragment_to_sellerMainFragment"
            app:destination="@id/sellerMainFragment"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/buyerMainFragment"
        android:name="com.pricefall.ui.fragments.buyer.main.BuyerMainFragment"
        android:label="fragment_buyer_main"
        tools:layout="@layout/fragment_buyer_main" />
    <fragment
        android:id="@+id/sellerMainFragment"
        android:name="com.pricefall.ui.fragments.seller.main.SellerMainFragment"
        android:label="fragment_seller_main"
        tools:layout="@layout/fragment_seller_main" />
</navigation>