<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/colorBackground"
    app:cardCornerRadius="25dp"
    app:cardElevation="0dp"
    app:contentPadding="16dp"
    app:strokeColor="#000"
    app:strokeWidth="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/images_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            tools:itemCount="1"
            android:paddingBottom="24dp"
            tools:listitem="@layout/one_image_item" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/images_recycler"
            tools:maxLength="30"
            tools:text="@tools:sample/lorem/random" />

        <TextView
            android:id="@+id/ends_after"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/title"
            tools:text="Ends After 8:32" />

        <TextView
            android:id="@+id/starting_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/shimmer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ends_after"
            tools:text="25.00" />

        <TextView
            android:id="@+id/starting_price_kd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:text="@string/kd"
            android:textColor="@color/shimmer"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@id/starting_price"
            app:layout_constraintTop_toTopOf="@id/starting_price" />

        <LinearLayout
            android:id="@+id/date_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@id/title">

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/shimmer"
                tools:text="30 April" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="4dp"
                android:textColor="@color/shimmer"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="•" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/shimmer"
                tools:text="12:30" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="4dp"
                android:textColor="@color/shimmer"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="•" />

            <TextView
                android:id="@+id/day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/colorPrimary"
                tools:text="Today" />

        </LinearLayout>

        <com.yy.mobile.rollingtextview.RollingTextView
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/date_time"
            tools:text="19.00" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:text="@string/kd"
            android:textColor="@color/shimmer"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/price"
            app:layout_constraintTop_toTopOf="@id/price" />

        <TextView
            android:id="@+id/quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/shimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/date_time"
            tools:text="1 out of 4 items" />

        <TextView
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/shimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/date_time"
            tools:text="00:32"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notify_me"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/background_rounded"
            android:elevation="0dp"
            android:paddingVertical="0dp"
            android:text="@string/notify_me"
            android:textAllCaps="false"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:cornerRadius="10dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_notification_animation"
            app:iconGravity="textStart"
            app:iconSize="36dp"
            app:iconTint="@color/black"
            app:layout_constraintTop_toBottomOf="@id/price" />
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintStart_toStartOf="@id/notify_me"
            app:layout_constraintEnd_toEndOf="@id/notify_me"
            app:layout_constraintTop_toTopOf="@id/notify_me"
            app:layout_constraintBottom_toBottomOf="@id/notify_me"
            android:src="@drawable/ic_notification_animation"
            android:elevation="16dp"
            android:visibility="gone"
            android:id="@+id/notify_me_img"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/set_price_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/background_rounded"
            android:elevation="0dp"
            android:text="@string/set_price_target"
            android:textAllCaps="false"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:cornerRadius="10dp"
            app:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/notify_me"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="2dp" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>