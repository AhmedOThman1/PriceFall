<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/endLogin"
        motion:constraintSetStart="@id/start"
        motion:duration="1000">
        <KeyFrameSet>

            <KeyAttribute
                android:alpha="0"
                motion:framePosition="30"
                motion:motionTarget="@+id/email" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="35"
                motion:motionTarget="@+id/password" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="75"
                motion:motionTarget="@+id/sign_up" />

        </KeyFrameSet>
        <OnClick motion:targetId="@+id/start_animation" />
    </Transition>
    <Transition
        motion:constraintSetEnd="@+id/endSign"
        motion:constraintSetStart="@id/start"
        motion:duration="1000">
        <KeyFrameSet>

            <KeyAttribute
                android:alpha="0"
                motion:framePosition="25"
                motion:motionTarget="@+id/full_name" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="25"
                motion:motionTarget="@+id/phone" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="25"
                motion:motionTarget="@+id/user_type" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="30"
                motion:motionTarget="@+id/email" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="35"
                motion:motionTarget="@+id/password" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="75"
                motion:motionTarget="@+id/login" />

        </KeyFrameSet>
        <OnClick motion:targetId="@+id/start_signup_animation" />
    </Transition>


    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="48dp"
            android:background="@drawable/background_rounded"
            android:elevation="4dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toEndOf="@+id/center" />
        <Constraint
            android:id="@+id/sign_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:alpha="1"
            android:backgroundTint="@color/white"
            android:elevation="4dp"
            android:visibility="visible"
            motion:layout_constraintEnd_toStartOf="@id/center"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="@id/login" />
        <Constraint
            android:id="@+id/user_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:alpha="0"
            android:visibility="invisible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/phone" />
        <Constraint
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:alpha="0"
            android:visibility="gone"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/login_logo_card" />

        <Constraint
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:visibility="gone"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/email" />
        <Constraint
            android:id="@+id/start_animation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="1"
            android:elevation="6dp"
            android:visibility="visible"
            motion:layout_constraintBottom_toBottomOf="@id/login"
            motion:layout_constraintEnd_toEndOf="@id/login"
            motion:layout_constraintStart_toStartOf="@id/login"
            motion:layout_constraintTop_toTopOf="@id/login" />
        <Constraint
            android:id="@+id/start_signup_animation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="1"
            android:elevation="6dp"
            android:visibility="visible"
            motion:layout_constraintBottom_toBottomOf="@id/sign_up"
            motion:layout_constraintEnd_toEndOf="@id/sign_up"
            motion:layout_constraintStart_toStartOf="@id/sign_up"
            motion:layout_constraintTop_toTopOf="@id/sign_up" />
        <Constraint
            android:id="@+id/login_logo_card"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            motion:layout_constraintBottom_toBottomOf="@id/login"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="@id/login"
            motion:visibilityMode="ignore" />

        <Constraint
            android:id="@+id/user_img"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="64dp"
            android:layout_marginBottom="24dp"
            android:alpha="0"
            android:src="@drawable/avatar"
            android:visibility="gone"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/login_logo_card" />
        <Constraint
            android:id="@+id/bg"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="300dp"
            android:layout_height="400dp"
            android:layout_marginBottom="32dp"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:alpha="1" />
        <Constraint
            android:id="@+id/bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@id/bg"
            android:alpha="1" />

    </ConstraintSet>


    <ConstraintSet android:id="@+id/endLogin">
        <Constraint
            android:id="@+id/login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/background_rounded_2"
            android:elevation="4dp"
            android:gravity="center"
            android:text="@string/login"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            motion:background="@drawable/background_rounded_2"
            motion:elevation="4dp"
            motion:layout_constraintEnd_toEndOf="@id/password"
            motion:layout_constraintStart_toStartOf="@id/password"
            motion:layout_constraintTop_toBottomOf="@id/password" />

        <Constraint
            android:id="@+id/sign_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:alpha="0"
            android:elevation="4dp"
            android:visibility="gone"
            motion:layout_constraintEnd_toStartOf="@id/center"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="@id/login" />
        <Constraint
            android:id="@+id/user_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:alpha="0"
            android:visibility="invisible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/phone" />
        <Constraint
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="32dp"
            android:alpha="1"
            android:visibility="visible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/login_logo_card" />
        <Constraint
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:alpha="1"
            android:visibility="visible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/email" />

        <Constraint
            android:id="@+id/login_logo_card"
            android:layout_width="wrap_content"
            android:layout_height="150dp"
            android:layout_marginTop="64dp"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/start_animation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:visibility="gone"
            motion:layout_constraintBottom_toBottomOf="@id/login"
            motion:layout_constraintEnd_toEndOf="@id/login"
            motion:layout_constraintStart_toStartOf="@id/login"
            motion:layout_constraintTop_toTopOf="@id/login" />
        <Constraint
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            motion:layout_constraintTop_toTopOf="@id/login"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintBottom_toBottomOf="@id/login"
            motion:visibilityMode="ignore" />
        <Constraint
            android:id="@+id/bg"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="300dp"
            android:layout_height="400dp"
            android:layout_marginBottom="32dp"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:alpha="0" />
        <Constraint
            android:id="@+id/bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@id/bg"
            android:alpha="0" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/endSign">
        <Constraint
            android:id="@+id/sign_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/background_rounded_2"
            android:backgroundTint="@null"
            android:elevation="4dp"
            android:gravity="center"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            motion:background="@drawable/background_rounded_2"
            motion:elevation="4dp"
            motion:layout_constraintEnd_toEndOf="@id/password"
            motion:layout_constraintStart_toStartOf="@id/password"
            motion:layout_constraintTop_toBottomOf="@id/password" />

        <Constraint
            android:id="@+id/login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:alpha="0"
            android:elevation="4dp"
            android:visibility="gone"
            motion:layout_constraintEnd_toStartOf="@id/center"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="@id/login" />


        <Constraint
            android:id="@+id/user_img"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="64dp"
            android:layout_marginBottom="24dp"
            android:alpha="1"
            android:src="@drawable/avatar"
            android:visibility="visible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/login_logo_card" />

        <Constraint
            android:id="@+id/full_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="32dp"
            android:alpha="1"
            android:visibility="visible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/user_img" />
        <Constraint
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:alpha="1"
            android:visibility="visible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/full_name" />
        <Constraint
            android:id="@+id/user_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:alpha="1"
            android:visibility="visible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/phone" />
        <Constraint
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="24dp"
            android:alpha="1"
            android:visibility="visible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/user_type" />
        <Constraint
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:alpha="1"
            android:visibility="visible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/email" />

        <Constraint
            android:id="@+id/login_logo_card"
            android:layout_width="wrap_content"
            android:layout_height="150dp"
            android:layout_marginTop="64dp"
            android:alpha="0"
            android:visibility="gone"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/start_animation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:visibility="gone"
            motion:layout_constraintBottom_toBottomOf="@id/login"
            motion:layout_constraintEnd_toEndOf="@id/login"
            motion:layout_constraintStart_toStartOf="@id/login"
            motion:layout_constraintTop_toTopOf="@id/login" />

        <Constraint
            android:id="@+id/start_signup_animation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:elevation="6dp"
            android:visibility="gone"
            motion:layout_constraintBottom_toBottomOf="@id/sign_up"
            motion:layout_constraintEnd_toEndOf="@id/sign_up"
            motion:layout_constraintStart_toStartOf="@id/sign_up"
            motion:layout_constraintTop_toTopOf="@id/sign_up" />

        <Constraint
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            motion:layout_constraintBottom_toBottomOf="@id/sign_up"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="@id/sign_up"
            motion:visibilityMode="ignore" />
        <Constraint
            android:id="@+id/bg"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="300dp"
            android:layout_height="400dp"
            android:layout_marginBottom="32dp"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:alpha="0" />

        <Constraint
            android:id="@+id/bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@id/bg"
            android:alpha="0" />

    </ConstraintSet>
</MotionScene>